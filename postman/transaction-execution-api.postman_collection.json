                { "key": "status", "value": "EXECUTED" },
                { "key": "limit", "value": "2" },
                { "key": "page", "value": "0" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('response refleja page=0, limit=2', () => {",
                  "  pm.expect(body.page).to.eql(0);",
                  "  pm.expect(body.limit).to.eql(2);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
