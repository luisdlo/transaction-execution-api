    {
      "name": "10 — Circuit breaker",
      "description": "⚠ Correr AL FINAL: deja el CB abierto ~10 segundos. Los 4 primeros POST saturan el sliding window; el 5to debe cortarse sin tocar al proveedor.",
      "item": [
        {
          "name": "Saturación 1 (acc-error)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"accountId\":\"acc-error\",\"type\":\"CREDIT\",\"amount\":100,\"currency\":\"MXN\"}" },
            "url": { "raw": "{{baseUrl}}/transactions", "host": ["{{baseUrl}}"], "path": ["transactions"] }
          }
        },
        {
          "name": "Saturación 2 (acc-error)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"accountId\":\"acc-error\",\"type\":\"CREDIT\",\"amount\":100,\"currency\":\"MXN\"}" },
            "url": { "raw": "{{baseUrl}}/transactions", "host": ["{{baseUrl}}"], "path": ["transactions"] }
          }
        },
        {
          "name": "Saturación 3 (acc-error)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"accountId\":\"acc-error\",\"type\":\"CREDIT\",\"amount\":100,\"currency\":\"MXN\"}" },
            "url": { "raw": "{{baseUrl}}/transactions", "host": ["{{baseUrl}}"], "path": ["transactions"] }
          }
        },
        {
          "name": "Saturación 4 (acc-error) + snapshot del contador de WireMock",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Guarda el contador de WireMock DESPUÉS de saturar.",
                  "pm.sendRequest(pm.collectionVariables.get('wiremockAdmin') + '/requests/count', (err, res) => {",
                  "  pm.collectionVariables.set('wiremockCountBefore', res.json().count);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
