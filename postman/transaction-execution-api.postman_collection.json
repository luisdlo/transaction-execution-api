{
  "info": {
    "name": "Transaction Execution API",
    "description": "Colección de smoke tests para la Transaction Execution API. Cada carpeta corresponde a un caso de scripts/*.sh. Requiere que la app corra en {{baseUrl}} y WireMock en {{wiremockAdmin}} (docker compose up -d).\n\nCada request tiene un test que valida el resultado esperado. Corre la colección completa con Runner o Newman para ver pass/fail agregado.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "wiremockAdmin", "value": "http://localhost:8081/__admin", "type": "string" },
    { "key": "idempotencyKey", "value": "k-postman-001", "type": "string" },
    { "key": "wiremockCountBefore", "value": "0", "type": "string" }
  ],
  "item": [
    {
      "name": "01 — Aprobado",
      "description": "WireMock devuelve 200 APPROVED para cualquier accountId no listado como especial. Espera HTTP 201 + status=EXECUTED.",
      "item": [
        {
          "name": "POST aprobado (acc-ok)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": \"acc-ok\",\n  \"type\": \"CREDIT\",\n  \"amount\": 1500.00,\n  \"currency\": \"MXN\",\n  \"description\": \"Test\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["transactions"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('status = EXECUTED', () => pm.expect(body.status).to.eql('EXECUTED'));",
                  "pm.test('providerTransactionId presente', () => pm.expect(body.providerTransactionId).to.be.a('string').and.not.empty);",
                  "pm.test('balanceAfter presente', () => pm.expect(body.balanceAfter).to.not.be.null);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 — Rechazo del proveedor",
      "description": "acc-fail dispara 400 INSUFFICIENT_FUNDS en WireMock. La API traduce a 201 con status=REJECTED — un rechazo de negocio NO es error HTTP.",
      "item": [
        {
          "name": "POST rechazado (acc-fail)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": \"acc-fail\",\n  \"type\": \"DEBIT\",\n  \"amount\": 100,\n  \"currency\": \"MXN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["transactions"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201 (NO 4xx — es rechazo de negocio)', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('status = REJECTED', () => pm.expect(body.status).to.eql('REJECTED'));",
                  "pm.test('failureCode = INSUFFICIENT_FUNDS', () => pm.expect(body.failureCode).to.eql('INSUFFICIENT_FUNDS'));",
                  "pm.test('failureMessage presente', () => pm.expect(body.failureMessage).to.be.a('string').and.not.empty);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 — Read timeout (no retry)",
      "description": "acc-slow dispara read timeout. Debe marcarse FAILED y NO reintentar (sólo 1 hit al proveedor).",
      "item": [
        {
          "name": "POST read timeout (acc-slow)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Guarda el contador de WireMock ANTES de la llamada.",
                  "pm.sendRequest(pm.collectionVariables.get('wiremockAdmin') + '/requests/count', (err, res) => {",
                  "  pm.collectionVariables.set('wiremockCountBefore', res.json().count);",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('status = FAILED', () => pm.expect(body.status).to.eql('FAILED'));",
                  "",
                  "// Compara el contador de WireMock: debe haber SUBIDO EXACTAMENTE 1.",
                  "pm.sendRequest(pm.collectionVariables.get('wiremockAdmin') + '/requests/count', (err, res) => {",
                  "  const before = parseInt(pm.collectionVariables.get('wiremockCountBefore'));",
                  "  const after = res.json().count;",
                  "  const diff = after - before;",
                  "  pm.test('sólo 1 hit al proveedor (no retry en read timeout)', () => pm.expect(diff).to.eql(1));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": \"acc-slow\",\n  \"type\": \"CREDIT\",\n  \"amount\": 100,\n  \"currency\": \"MXN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["transactions"]
            }
          }
        }
      ]
    },
    {
      "name": "04 — Idempotencia",
      "description": "Dos POST idénticos con el mismo Idempotency-Key devuelven el MISMO id.",
      "item": [
        {
          "name": "POST 1 (fija idempotencyKey único)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Genera una key nueva por corrida de la colección para que el test",
                  "// no colisione con datos preexistentes.",
                  "pm.collectionVariables.set('idempotencyKey', 'k-postman-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('id presente', () => pm.expect(body.id).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set('firstTxnId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": \"acc-idem\",\n  \"type\": \"CREDIT\",\n  \"amount\": 200,\n  \"currency\": \"MXN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["transactions"]
            }
          }
        },
        {
          "name": "POST 2 (mismo body, misma key — debe devolver el mismo id)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "const firstId = pm.collectionVariables.get('firstTxnId');",
                  "pm.test('mismo id que POST 1 (idempotencia)', () => pm.expect(body.id).to.eql(firstId));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": \"acc-idem\",\n  \"type\": \"CREDIT\",\n  \"amount\": 200,\n  \"currency\": \"MXN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["transactions"]
            }
          }
        }
      ]
    },
    {
      "name": "05 — Normalización de currency",
      "description": "Enviar currency=\"mxn\" (minúsculas). El controller normaliza a \"MXN\" antes de persistir; el CHECK constraint de la BD sólo acepta el literal en mayúsculas.",
      "item": [
        {
          "name": "POST currency mxn (lowercase)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": \"acc-ok\",\n  \"type\": \"CREDIT\",\n  \"amount\": 100,\n  \"currency\": \"mxn\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["transactions"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.test('currency normalizada a MXN', () => pm.expect(pm.response.json().currency).to.eql('MXN'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "06 — Reglas de negocio (422)",
