    {
      "name": "08 — Query paginada",
      "description": "GET /transactions con filtros y paginación. hasNext se calcula pidiendo limit+1 filas.",
      "item": [
        {
          "name": "primera página con limit chico",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/transactions?limit=3",
              "host": ["{{baseUrl}}"],
              "path": ["transactions"],
              "query": [{ "key": "limit", "value": "3" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('shape completo (items, page, limit, hasNext)', () => {",
                  "  pm.expect(body).to.have.property('items');",
                  "  pm.expect(body).to.have.property('page');",
                  "  pm.expect(body).to.have.property('limit');",
                  "  pm.expect(body).to.have.property('hasNext');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "filtrar por status=REJECTED",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/transactions?status=REJECTED&limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["transactions"],
              "query": [
                { "key": "status", "value": "REJECTED" },
                { "key": "limit", "value": "5" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const items = pm.response.json().items;",
                  "pm.test('todos los items respetan el filtro (o no vinieron items)', () => {",
                  "  items.forEach(t => pm.expect(t.status).to.eql('REJECTED'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "paginación explícita (page=0, limit=2)",
